From d945846558bf904e45f4e618a2ebcd4c108668ba Mon Sep 17 00:00:00 2001
From: JorreFog <JorreFog@users.noreply.github.com>
Date: Sun, 25 Oct 2026 13:42:16 +0100
Subject: [PATCH 07/12] DraStic's sound wait sleeps until the pump's next call
 instead of spinning

audio_sync() polls its ring with delay_us(10), which is SDL_Delay(10 / 1000) = SDL_Delay(0): DraStic's main thread
spun through it, a syscall at a time, whenever it was ahead of its sound. That spin was counted by cpugov as load
(Mario Kart DS racing on the RG DS Plus: main thread 76-90% busy at 1992 MHz, 70% at 1416) and kept the top clock.
The ring only drains when the pump calls DraStic's callback, so an SDL_Delay(0) that returns into audio_sync (matched
by its code: ldp/ldr/sub after mov w0, #10; bl delay_us; r2.5.2.x at 0x88678 in both the ROCKNIX and BananaOS
builds) now waits on a futex the pump bumps after each call (at most 8 ms). Other SDL_Delay calls are untouched.
DSFLIP_AUDIO_WAIT=0: the spin as before. Not with low latency (DSFLIP_LOWLAT=1 paces DraStic itself).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit ea1bcf032c3446f44f828d089fa2a7c10a6fe9aa)
---
 src/audio.c  | 20 +++++++++++++++++++-
 src/dsflip.c | 29 +++++++++++++++++++++++++++++
 2 files changed, 48 insertions(+), 1 deletion(-)

diff --git a/src/audio.c b/src/audio.c
index 9883bac..458f740 100644
--- a/src/audio.c
+++ b/src/audio.c
@@ -45,6 +45,8 @@
 #include <poll.h>
 #include <fcntl.h>
 #include <signal.h>
+#include <sys/syscall.h>
+#include <linux/futex.h>
 #include <unistd.h>
 
 void dsflip_log(const char *fmt, ...);
@@ -209,6 +211,22 @@ static void ui_mix(unsigned char *buf, int frames) {
     __atomic_compare_exchange_n(&ui_pos, &p, next, 0, __ATOMIC_ACQ_REL, __ATOMIC_RELAXED);
 }
 
+/* DraStic's sound wait (audio_sync) polls its ring with SDL_Delay(0), a spin: the ring only drains when the pump calls
+ * its callback, so dsflip.c's SDL_Delay hook sleeps here until the pump's next call instead (audio_wait_drain) */
+static int pump_tick, tick_waiters;
+static void tick_bump(void) {
+    __atomic_add_fetch(&pump_tick, 1, __ATOMIC_RELEASE);
+    if (__atomic_load_n(&tick_waiters, __ATOMIC_ACQUIRE)) syscall(SYS_futex, &pump_tick, FUTEX_WAKE_PRIVATE, INT_MAX, 0, 0, 0);
+}
+/* until the pump's next call into DraStic's callback, at most timeout_us */
+void audio_wait_drain(int timeout_us) {
+    int t = __atomic_load_n(&pump_tick, __ATOMIC_ACQUIRE);
+    struct timespec ts = { 0, timeout_us * 1000L };
+    __atomic_add_fetch(&tick_waiters, 1, __ATOMIC_ACQ_REL);
+    syscall(SYS_futex, &pump_tick, FUTEX_WAIT_PRIVATE, t, &ts, 0, 0);
+    __atomic_sub_fetch(&tick_waiters, 1, __ATOMIC_ACQ_REL);
+}
+
 static double lock_in;                   /* DraStic's rate as taken with DSFLIP_AUDIO_LOCK (see alsa_open), else 0: the pump's
                                             nominal rate too, so its trim stays the few ppm it is without the lock */
 static void *pump(void *a) {             /* steady calls into DraStic's callback */
@@ -229,7 +247,7 @@ static void *pump(void *a) {             /* steady calls into DraStic's callback
             if (av < chunk) { st_dshort++; st_dshort_fr += chunk - av; audio_runouts++; }
         }
         if (paused) memset(tmp, 0, (size_t)chunk * fb);   /* the menu's sounds over silence (16-bit samples) */
-        else { dcb(dud, tmp, chunk * fb); if (mute) memset(tmp, 0, (size_t)chunk * fb); }
+        else { dcb(dud, tmp, chunk * fb); tick_bump(); if (mute) memset(tmp, 0, (size_t)chunk * fb); }
         sfx_mix(tmp, chunk);
         ui_mix(tmp, chunk);
         st_pump++; st_pumped += chunk;
diff --git a/src/dsflip.c b/src/dsflip.c
index ae7fda4..6ffc6a3 100644
--- a/src/dsflip.c
+++ b/src/dsflip.c
@@ -1812,6 +1812,35 @@ int SDL_Init(uint32_t flags) {
     if (ok && (flags & 0x10 /* SDL_INIT_AUDIO */) && audio_pump_enabled() && audio_out_alsa()) { flags &= ~0x10u; audio_sdl_off = 1; }
     return real(flags);
 }
+/* DraStic's sound wait, audio_sync(): "while its ring is 3/4 full or more: delay_us(10)", and delay_us(10) is
+ * SDL_Delay(10 / 1000) = SDL_Delay(0), so the main thread spins through it, a syscall at a time, whenever DraStic is
+ * ahead of its sound: most of every frame in a light scene. That spin was most of the main thread's CPU time (Mario
+ * Kart DS racing: 76-90% busy at 1992 MHz, 70% at 1416), which cpugov read as load and kept the top clock for. The
+ * ring drains only when the pump calls DraStic's callback, so that SDL_Delay(0) sleeps until the pump's next call
+ * (audio.c, at most 8 ms). Recognised by the code it returns to (delay_us tail-calls SDL_Delay, so the return address
+ * is in audio_sync, after "mov w0, #10; bl delay_us": "ldp w0, w1, [x19, #8]; ldr w2, [x19, #24]; sub w1, w1, w0",
+ * r2.5.2.x at 0x88678). Any other SDL_Delay goes through as it was. DSFLIP_AUDIO_WAIT=0: the spin as before; not with
+ * low latency, which paces DraStic itself. */
+void audio_wait_drain(int timeout_us);
+static int audio_wait = -1;
+static const uint32_t *sync_ra;
+static int is_audio_sync(const uint32_t *ra) {
+    return ra[0] == 0x29410660u && ra[1] == 0xb9401a62u && ra[2] == 0x4b000021u && ra[-2] == 0x52800140u &&
+           (ra[-1] >> 26) == 0x25;                       /* bl */
+}
+void SDL_Delay(uint32_t ms) {
+    REAL(void, SDL_Delay, uint32_t);
+    if (!ms && pump_on && !pacing_lowlat) {
+        if (audio_wait < 0) { const char *e = getenv("DSFLIP_AUDIO_WAIT"); audio_wait = !(e && *e == '0'); }
+        const uint32_t *ra = __builtin_return_address(0);
+        if (audio_wait && (ra == sync_ra || (!sync_ra && is_audio_sync(ra)))) {
+            if (!sync_ra) { sync_ra = ra; LOG("[audio] DraStic's sound wait sleeps until the pump's next call (was a spin)\n"); }
+            audio_wait_drain(8000);
+            return;
+        }
+    }
+    real(ms);
+}
 struct SDL_AudioSpec_ { int freq; unsigned short format; unsigned char channels, silence;
     unsigned short samples, padding; uint32_t size; void (*callback)(void *, unsigned char *, int); void *userdata; };
 int SDL_OpenAudio(struct SDL_AudioSpec_ *want, struct SDL_AudioSpec_ *have) {
