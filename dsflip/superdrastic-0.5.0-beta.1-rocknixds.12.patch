From 31e86bb08868a848a13111a51c06fdec13120a3b Mon Sep 17 00:00:00 2001
From: JorreFog <JorreFog@users.noreply.github.com>
Date: Mon, 26 Oct 2026 23:04:41 +0100
Subject: [PATCH 01/12] menu: a quit (SIGTERM) while the in-game menu is open
 closes it and reaches DraStic

The menu drains DraStic's SDL queue with the real SDL_PollEvent while it is
open, and handle_sdl only looked at joystick/touch events: the SDL_QUIT that
SDL makes of a SIGTERM was eaten, so DraStic never quit (still running after
the menu closed; only -9 ended it). Now handle_sdl closes the menu and pushes
the event back. Measured on the RG DS (0.5.0-beta.2, bind-mounted lib): TERM
with the menu open, gone in 0.2 s (was: alive 8 s later and after closing).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 1305ea3b124acfd65b69ca5d8e9f0d10892df481)
(cherry picked from commit fb7c79cc17f92fec0fd6549ba0de9d522c3a7b0b)
---
 src/menu.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/menu.c b/src/menu.c
index 66bed23..5da97fa 100644
--- a/src/menu.c
+++ b/src/menu.c
@@ -59,6 +59,7 @@ int dsflip_shader_on(void);
 /* shader.c */
 const char *shader_name(void);
 int shader_list(char (*names)[48], int max);
+int SDL_PushEvent(void *event);
 /* audio.c */
 void audio_mute(int on);
 int audio_ui_load(int id, const int16_t *pcm, int frames, int rate, int ch);
@@ -1252,6 +1253,15 @@ static void dir_press(int dx, int dy) { nav(dx, dy); held_dir = 1; rep_dx = dx;
 static void dir_release(void) { held_dir = 0; }
 static void handle_sdl(const uint8_t *e) {
     uint32_t type; memcpy(&type, e, 4);
+    if (type == 0x100) {                            /* SDL_QUIT (SIGTERM: a shutdown, the menu's quit): the menu's own
+                                                     * poll took it from DraStic, which would never quit. Close and
+                                                     * hand it back, so DraStic quits as it does without the menu */
+        uint8_t q[64]; memcpy(q, e, sizeof q);
+        dsflip_log("[menu] quit asked while open: closing, DraStic quits\n");
+        close_menu();
+        SDL_PushEvent(q);
+        return;
+    }
     if (type == 0x603 || type == 0x604) {           /* SDL_JOYBUTTONDOWN / UP */
         int b = e[12], down = type == 0x603;
         if (!down) { if (b == b_up || b == b_down || b == b_left || b == b_right) dir_release(); return; }
-- 
