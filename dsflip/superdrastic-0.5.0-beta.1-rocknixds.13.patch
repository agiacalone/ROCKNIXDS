+/* buttons whose held-ness changed between was and now. btn[i] is the button, down[i] is 1 pressed / 0 released. */
+int resume_hold_edges(uint64_t was, uint64_t now, unsigned char *btn, unsigned char *down, int max) {
+    int n = 0;
