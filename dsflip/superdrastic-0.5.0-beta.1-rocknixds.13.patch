         check(d.strip() == '(DSF_TS.z / 256.0)', 'shaders/%s: SCREEN_RES_SCALE %s' % (f, d.strip()))
+# Retro tiles: fade() takes a distance, so pos has to be without its sign once dir has it (with it, one half of each tile
