From c33ba55610ab5d16138dd06e00a0c8de5663af90 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Sun, 15 Nov 2026 11:08:56 +0000
Subject: [PATCH 1/7] Touch lookup: realpath's buffer is PATH_MAX, so a
 fortified build does not abort at startup

glibc's __realpath_chk aborts when the resolved-path buffer is shorter than PATH_MAX. touch_find passed 512 bytes, so BananaLinux (built with _FORTIFY_SOURCE) died in the touch thread before the first frame. The same call with PATH_MAX is what the release line already uses.

Co-authored-by: Joar <JorreFog@users.noreply.github.com>
(cherry picked from commit 296c2734c6578744da4594642a511300fcae8aff)
---
 src/dsflip.c                  |  3 +-
 tools/realpath-fortify-test.c | 70 +++++++++++++++++++++++++++++++++++
 2 files changed, 72 insertions(+), 1 deletion(-)
 create mode 100644 tools/realpath-fortify-test.c

diff --git a/src/dsflip.c b/src/dsflip.c
index b7c88e5..4a003b1 100644
--- a/src/dsflip.c
+++ b/src/dsflip.c
@@ -33,6 +33,7 @@
 //   DSHOOK_SHADER=name             ES's DraStic "shader" setting; anything but bilinear/none runs that shader on the
 //                                  GPU (shader.c). DSFLIP_SHADER overrides it
 #define _GNU_SOURCE
+#include <limits.h>
 #include <stdint.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -1394,7 +1395,7 @@ static int touch_find(const char *want, char *path, size_t n) {   /* the evdev n
     glob_t g; *path = 0;
     if (glob("/sys/class/input/event*", 0, 0, &g)) return -1;
     for (size_t i = 0; i < g.gl_pathc && !*path; i++) {
-        char dev[300], real_[512]; snprintf(dev, sizeof dev, "%s/device", g.gl_pathv[i]);
+        char dev[300], real_[PATH_MAX]; snprintf(dev, sizeof dev, "%s/device", g.gl_pathv[i]);   /* realpath wants PATH_MAX: a smaller buffer aborts under _FORTIFY_SOURCE */
         if (realpath(dev, real_) && strstr(real_, want)) snprintf(path, n, "/dev/input/%s", strrchr(g.gl_pathv[i], '/') + 1);
     }
     globfree(&g);
diff --git a/tools/realpath-fortify-test.c b/tools/realpath-fortify-test.c
new file mode 100644
index 0000000..d8d890b
--- /dev/null
+++ b/tools/realpath-fortify-test.c
@@ -0,0 +1,70 @@
+/* glibc's fortified realpath aborts when the resolved-path buffer is smaller than PATH_MAX,
+ * before it looks at the path (__realpath_chk). touch_find used 512 bytes, so a build with
+ * _FORTIFY_SOURCE (BananaLinux) died in the touch thread at startup and the game never showed a frame.
+ *
+ *   gcc -O2 -D_FORTIFY_SOURCE=2 -o /tmp/realpath-fortify-test tools/realpath-fortify-test.c
+ *   /tmp/realpath-fortify-test
+ *
+ * Run from the repo root. The PATH_MAX call must succeed. The old 512-byte call must die with SIGABRT.
+ * src/dsflip.c's touch_find buffer must be PATH_MAX.
+ */
+#define _GNU_SOURCE
+#include <fcntl.h>
+#include <limits.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+static int source_ok(void) {
+    FILE *f = fopen("src/dsflip.c", "r");
+    if (!f) { fprintf(stderr, "run from the repo root (src/dsflip.c not found)\n"); return 0; }
+    char line[800];
+    int good = 0, bad = 0;
+    while (fgets(line, sizeof line, f)) {
+        if (strstr(line, "real_[512]")) bad = 1;
+        if (strstr(line, "real_[PATH_MAX]")) good = 1;
+    }
+    fclose(f);
+    if (bad || !good) {
+        fprintf(stderr, "touch_find buffer: PATH_MAX present %d, 512-byte present %d\n", good, bad);
+        return 0;
+    }
+    return 1;
+}
+
+/* the buffer touch_find used to pass. object size is visible, so fortify checks it. */
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wattribute-warning"
+static int short_buf(void) {
+    char buf[512];
+    return realpath("/proc/self/exe", buf) ? 0 : 2;
+}
+#pragma GCC diagnostic pop
+
+static int short_aborts(void) {
+    pid_t p = fork();
+    if (p < 0) return 0;
+    if (p == 0) {
+        int n = open("/dev/null", O_WRONLY);
+        if (n >= 0) dup2(n, 2);
+        _exit(short_buf());
+    }
+    int st = 0;
+    if (waitpid(p, &st, 0) < 0) return 0;
+    return WIFSIGNALED(st) && WTERMSIG(st) == SIGABRT;
+}
+
+int main(void) {
+    if (!source_ok()) return 1;
+    char buf[PATH_MAX];
+    if (!realpath("/proc/self/exe", buf)) { perror("realpath PATH_MAX"); return 1; }
+    if (!short_aborts()) {
+        fprintf(stderr, "a 512-byte realpath buffer did not abort; compile with -O2 -D_FORTIFY_SOURCE=2\n");
+        return 1;
+    }
+    printf("realpath-fortify-test: ok\n");
+    return 0;
+}
-- 
2.56.0


From 5a39fbb31dd1f8307686416cfcc79e3ad1be45d8 Mon Sep 17 00:00:00 2001
From: JorreFog <JorreFog@users.noreply.github.com>
Date: Wed, 4 Nov 2026 18:54:02 +0100
Subject: [PATCH 2/7] NNDDSS shaders: SCREEN_RES_SCALE from the frame's width,
 not 1/width (BananaLinux #76)

Dot (MiZai), Dot (MiZai, RG DS+) and Retro tiles drew no dot / tile grid: conv-dfx.py set SCREEN_RES_SCALE to
(u_texture_size.x / 256.0) and then renamed u_texture_size to DSF_TS, which is (1/w, 1/h, w, h), so the scale
was 1/(256 w) (~1/65536 at 2x) and pixel_no ran ~65,000 times too fine. Now (DSF_TS.z / 256.0): 1 at 1x, 2 at 2x.
The three shipped shaders get the same one-line change (the NNDDSS sources aren't in the repo to convert again).

Test: tools/shaders/tests/conv-dfx-test.py (python3 -I): red before (the converter's output and the 3 shaders),
green after.
On device (RG DS, BananaOS 0.5.3, Mali-G52, shtest on the colour-bar/checker/gradient picture, 512x384 = 2x and
256x192): stock Dot MiZai flat and dimmed with no grid, stock Retro tiles a white picture; fixed: one dot / tile
per DS pixel, full brightness. Dot MiZai RG DS+ also through BananaDS's real launcher (bind mount, undone): loads
and draws. Not checked on the Plus or in SuperDrastic (DraStic) itself.

