From 6b0994f44439eb581b3c7e241b2947f08413ee4d Mon Sep 17 00:00:00 2001
From: JorreFog <JorreFog@users.noreply.github.com>
Date: Sat, 24 Oct 2026 22:49:53 +0200
Subject: [PATCH 01/11] DraStic's clock: a gap of more than a second in
 gettimeofday is taken out (the long white screen after a sleep, #64)

DraStic's frame wait works out "last + 14 ms - now" in 32-bit microseconds. The game is stopped while the handheld
sleeps but the wall clock runs on, so the first wait after a sleep of more than 36 minutes wrapped to a large
positive delay and DraStic slept up to another 36 minutes (white panels, the game frozen, longer the longer it
slept). On the RG DS a 1 h jump of the clock froze MKDS for over a minute before; now it runs on at once. The DS's
clock reads time(), so the game's date and time are unchanged. DSFLIP_CLOCK_GAPS=1 keeps the raw clock.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 26ca9f55549ae7be2cee0819bd33bdddac43672e)
---
 src/dsflip.c | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/src/dsflip.c b/src/dsflip.c
index 81f5d19..56647bf 100644
--- a/src/dsflip.c
+++ b/src/dsflip.c
@@ -266,6 +266,34 @@ void dsflip_log(const char *fmt, ...) {
     va_list ap; va_start(ap, fmt); vfprintf(lg, fmt, ap); va_end(ap);
 }
 
+/* ---------- DraStic's clock ----------
+ * DraStic paces with gettimeofday, and its wait (0x8a010 in 2.5.2.x) works out "last + 14 ms - now" in 32-bit
+ * microseconds. While the handheld sleeps the game is stopped but the wall clock runs on, so the first wait after
+ * waking sees a jump of hours: past 2^31 us (36 min) the difference wraps to a large positive number and DraStic
+ * sleeps for up to another 36 minutes (white panels, a frozen game, longer the longer it slept; #64). A gap of more
+ * than a second between two calls (DraStic calls it every frame) is therefore taken out of the clock it sees: time
+ * asleep, SIGSTOP'd (dark on the charger), or a clock set while it ran. The DS's own clock reads time(), so the
+ * game's date and time stay right. DSFLIP_CLOCK_GAPS=1 keeps the raw clock. */
+int gettimeofday(struct timeval *restrict tv, void *restrict tz) {
+    REAL(int, gettimeofday, struct timeval *restrict, void *restrict);
+    static int raw = -1;
+    static pthread_mutex_t mu = PTHREAD_MUTEX_INITIALIZER;
+    static long long last, cut;             /* the last raw time returned (us), and the gaps taken out so far */
+    int r = real(tv, tz);
+    if (r || !tv) return r;
+    if (raw < 0) { const char *e = getenv("DSFLIP_CLOCK_GAPS"); raw = e && *e == '1'; }
+    if (raw) return r;
+    long long t = tv->tv_sec * 1000000LL + tv->tv_usec, gap = 0;
+    pthread_mutex_lock(&mu);
+    if (last && (t - last > 1000000 || t < last)) { gap = t - last; cut += gap - 1000; }  /* as if 1 ms had passed */
+    last = t;
+    t -= cut;
+    pthread_mutex_unlock(&mu);
+    if (gap) dsflip_log("[clock] a %+.1f s gap in the wall clock taken out of DraStic's\n", gap / 1e6);
+    tv->tv_sec = t / 1000000; tv->tv_usec = t % 1000000;
+    return 0;
+}
+
 /* ---------- presenter ---------- */
 static int pending_mask;                /* bit i: a flip event is still due for panel i's CRTC */
 
-- 
