From e3bb991cb76700edfddd7efaa2fae56902f4881a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 12 Oct 2026 17:12:39 +0000
Subject: [PATCH 09/11] superdrastic-run: a TERM stops DraStic when it runs
 without SuperDrastic too

With no "ready" verdict (in BananaLinux's QEMU boot test, say) the runner
exec'd plain DraStic, whose SDL turns a TERM into a quit event DraStic
ignores: a shutdown or the frontend ending the game waited forever. DraStic
now runs in the background there as well, with the same stop trap.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016NcGDNSjDTqMmWCvL5Jnhk
(cherry picked from commit ebae0d13168bcf7196bc9b76c4e56deefd08d6c9)
---
 runner/superdrastic-run | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/runner/superdrastic-run b/runner/superdrastic-run
index 77c5ac0..39737d0 100755
--- a/runner/superdrastic-run
+++ b/runner/superdrastic-run
@@ -143,7 +143,11 @@ if [ "$v" != ready ]; then
     trap - TERM INT HUP
     [ "${DSFLIP_FALLBACK:-1}" = 0 ] && exit 1
     say "running DraStic without SuperDrastic"
-    plain "$@"
+    # not exec'd: DraStic's SDL turns a TERM into a quit event that DraStic ignores, so a stop (a shutdown, the
+    # frontend ending the game) has to kill it, as above
+    ( cd "$WORKDIR" && exec "$DRASTIC" "$@" ) &
+    P=$!
+    trap stop_game TERM INT HUP
 fi
 wait $P; rc=$?
 cpu_back                       # at once: SuperDrastic's governor may have lowered the limit
-- 
