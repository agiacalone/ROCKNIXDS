From b9826c4d7be0c46b762eb19239992cd55828cf72 Mon Sep 17 00:00:00 2001
From: Anthony Giacalone <anthony.giacalone@csulb.edu>
Date: Sun, 1 Nov 2026 11:12:10 -0800
Subject: [PATCH 11/11] Shaders: libretro's #pragma parameter lines compile on
 the Mali blob

Seven of the libretro shaders added on the BananaOS line (bevel, lcd1x,
lcd1x-nds, retro-v2, sharp-bilinear-scanlines, zfast-crt, zfast-lcd)
failed on ROCKNIX: its Mali driver (libmali g29p1) refuses the quotes in
'#pragma parameter NAME "Label" ...' with L0001 Unknown character,
where Mesa lets the pragma go. The loader now turns those lines into
comments in place ('#p' -> '//', same length and lines). The converted
shaders set their parameters to the defaults, so nothing is lost.

Checked on an RG DS Plus with tools/shtest: all 29 shaders compile and
draw at 256x192 and 512x384 into 1024x768 (was 22 of 29).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LMsLD8jTdPsU6UcXHj7s2H
---
 src/shader.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/shader.c b/src/shader.c
index ee8f787..4f8114d 100644
--- a/src/shader.c
+++ b/src/shader.c
@@ -313,6 +313,14 @@ static int compile_named(const char *name, GLuint *out, shlines *L) {
         fs = slurp(path, &n); from = path;
     }
     if (!fs) { SLOG("[shader] unknown shader \"%s\" (not built into libdrastouch, no %s.frag in the shader folders)\n", name, name); return 0; }
+    /* libretro's "#pragma parameter NAME "Label" ..." lines: the Mali blob (ROCKNIX's libmali, g29p1) refuses the
+     * quotes in them ("L0001: Unknown character '"'"), where Mesa lets an unknown pragma go. They only describe the
+     * parameters, which the converted shaders set to their defaults, so each is turned into a comment in place
+     * ("#p" -> "//"): the same length and lines, so the compiler's line numbers still match the file. */
+    for (char *p = fs; (p = strstr(p, "#pragma parameter")); p += 2) {
+        const char *b = p; while (b > fs && (b[-1] == ' ' || b[-1] == '\t')) b--;
+        if (b == fs || b[-1] == '\n') { p[0] = '/'; p[1] = '/'; }
+    }
     { const char *m = strstr(fs, "dsflip-viewport:"); char word[16];
       if (m && sscanf(m + 16, "%d %d %d %d", &L->vp[0], &L->vp[1], &L->vp[2], &L->vp[3]) == 4)
           SLOG("[shader] draws the DS screen at %d,%d %dx%d of the panel (touch follows)\n", L->vp[0], L->vp[1], L->vp[2], L->vp[3]);
